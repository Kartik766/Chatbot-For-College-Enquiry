# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Leave empty to auto-pick a currently available Llama model from Groq.
# Or pin one (check http://localhost:3000/api/models for what your key can use).
GROQ_MODEL=

# Optional tuning
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TOP_K=5
# PORT=3000
# OCR_WORKERS=3
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
